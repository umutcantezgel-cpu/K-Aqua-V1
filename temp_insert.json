  "customerReviews": {
    "eyebrow": "ගුණාත්මකභාවය සම්බන්ධ කරයි",
    "title": "අපගේ පාරිභෝගිකයින් සහ හවුල්කරුවන් පවසන දේ",
    "lead": "ඉදිකිරීම්කරුවන්ගේ සිට ලොජිස්ටික්ස් සහ දිගු කාලීන සේවකයින් දක්වා: K-Aqua KWT GmbH යනු Waldsolms හි ඉහළම නිරවද්‍යතාවය නියෝජනය කරයි. අපගේ සේවාව සහ අපගේ \"ජර්මනියේ නිෂ්පාදිත\" (Made in Germany) නිෂ්පාදන පිළිබඳව දිනපතා මිනිසුන් අත්විඳින දේ ඔබම කියවන්න.",
    "trustBadge": "Google සමාලෝචන (Reviews)",
    "trustStars": "4.9 / 5",
    "trustBasedOn": "(සමාලෝචන 44ක් මත පදනම්ව)",
    "tabA": "ගුණාත්මකභාවය සහ \"Made in Germany\"",
    "tabB": "ප්‍රවාහනය (Logistics) සහ බෙදා හැරීම",
    "tabC": "පාරිභෝගික සේවය සහ කණ්ඩායම",
    "reviews": {
      "a1": "\"ජර්මනියේ Waldsolms හි පිහිටි කර්මාන්තශාලාවක්, **ජර්මනියේ නිෂ්පාදිත** (Made in Germany) PPR පයිප්ප සහ උපාංග සඳහා විශේෂිත වේ. විශිෂ්ට කාර්ය මණ්ඩලයක්.\"",
      "a1Author": "Giulio C.",
      "a2": "\"PPR ආලේපන (coatings) සහ සවි කිරීම් වල **ජර්මානු ගුණාත්මකභාවය**, ඉතා මිත්‍රශීලී කාර්ය මණ්ඩලය.\"",
      "a2Author": "Veronica P.",
      "a3": "\"**නවීන සමාගමක්**. සියලුම ප්‍රමාණයේ ප්ලාස්ටික් පයිප්ප සහ උපාංග නිෂ්පාදනය කරයි.\"",
      "a3Author": "Ewald S.",
      "a4": "\"**ජර්මානු නිෂ්පාදිත** PPR පයිප්ප සහ උපාංග, විශිෂ්ට සේවකයින් සහ නිෂ්පාදන.\"",
      "a4Author": "Kais S.",
      "a5": "\"**උසස් තත්ත්වයේ නිෂ්පාදන** සහ ඉහළම ජර්මානු කර්මාන්තශාලාවක්.\"",
      "a5Author": "Abdoo4560 D. / Al B. / Vito Nadir H.",
      "a6": "\"ඉතා හොඳ නිෂ්පාදන, **විශ්වාසදායක ගුණාත්මකභාවය** සහ නියමිත වේලාවට බෙදා හැරීම.\"",
      "a6Author": "Klaus T.",
      "b1": "\"ඉතා හොඳ සැලකිල්ලක්, **වේගවත් බෑම (unloading)**. මගේ විශාල විවේකය මෙහි ගත කිරීමට මට අවසර ලැබුණි. මට නාන කාමරයක් සහ වැසිකිළියක් ද ලබා දුන්නා. ට්‍රක් රථ රියදුරෙකු ලෙස ඔබට මෙහි **අගයක්** දැනෙනවා. මම නැවත මෙහි පැමිණීමට කැමතියි.\"",
      "b1Author": "Michael S.",
      "b2": "\"ඇතුල්වීමේ වත්මන් ඛණ්ඩාංක (coordinates) **50.428210, 8.499154** වේ. මීටර් 100ක් පමණ දුරින් රථගාලක් ඇත. මිත්‍රශීලී කාර්ය මණ්ඩලයක්.\"",
      "b2Author": "Oleg M. / Hasan S.",
      "b3": "\"**වේගවත් බෑම**, මිත්‍රශීලී සහ ප්‍රයෝජනවත් කාර්ය මණ්ඩලය.\"",
      "b3Author": "Bogdan M.",
      "c1": "\"**ඉතා හොඳ සේවාවක්**, තවමත් ජර්මනියේ නිෂ්පාදනය කිරීම සතුටක්.\"",
      "c1Author": "Daniel",
      "c2": "\"**ඉතා මිත්‍රශීලී** සහ උපකාරශීලී කාර්ය මණ්ඩලයක්. විද්‍යුත් තැපැල් වලට **වහාම පිළිතුරු දෙනු ලැබේ**.\"",
      "c2Author": "Mohamed M.",
      "c3": "\"සභාපතිගේ සිට සාමාන්‍ය කම්කරුවන් දක්වා: ඔවුන් **හොඳ මිනිසුන්**.\"",
      "c3Author": "Azim",
      "c4": "\"**විශිෂ්ට සමාගමක්**, එහි සේවකයින් සඳහා බොහෝ දේ කරයි.\"",
      "c4Author": "Monika v. B.",
      "c5": "\"කාර්ය මණ්ඩලය **ඉතා මිත්‍රශීලී සහ උපකාරශීලී**.\"",
      "c5Author": "Piera V.",
      "c6": "\"දක්ෂ කණ්ඩායමක් සහ සෑම තරාතිරමකම **විශිෂ්ට පාරිභෝගික සත්කාරයක්**.\"",
      "c6Author": "Sarah B."
    },
    "ctaTitle": "අපගේ සේවාව ගැන ඔබම ඒත්තු ගන්වන්න.",
    "ctaText": "අපගේ PPR නල පද්ධති පිළිබඳව ඔබට ප්‍රශ්න තිබේද නැතහොත් ව්‍යාපෘතියක් අප සමඟ සාකච්ඡා කිරීමට අවශ්‍යද? අපගේ Waldsolms කණ්ඩායම ඔබ වෙනුවෙන් මෙහි සිටී.",
    "ctaBtn": "දැන් අප අමතන්න",
    "disclaimer": "සමාලෝචන තහවුරු කිරීම පිළිබඳ සටහන: මෙහි පෙන්වා ඇති සමාලෝචන අපගේ Google ව්‍යාපාරික පැතිකඩෙන් ලබාගෙන ඇත. ගූගල් ප්‍රකාශ කරන්නේ: සමාලෝචන සත්‍යාපනය කර නොමැත. දත්ත ආරක්ෂණ (GDPR) හේතූන් මත අපි කතුවරුන්ගේ නම් කෙටි කර ඇත."
  },
