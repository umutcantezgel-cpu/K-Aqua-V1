# ── K-Aqua environment ──────────────────────────────────────────
# Copy to .env.local and fill in. The current prototype needs NONE of these
# to build — they are forward-looking for Phase 2 (CMS, forms, analytics).

# Public site URL (used by sitemap.ts, robots.ts, OG images, hreflang)
NEXT_PUBLIC_SITE_URL=https://www.k-aqua.de

# Google Maps JavaScript API — Kartenbaustein auf /referenzen
#
# Der Schluessel stand zuvor im Klartext in
# components/sections/maps/KAquaMapsSuite.tsx. Fehlt er, laedt die Karte
# nicht und die Seite bleibt fehlerfrei — sie zeigt den Kartenbereich dann
# einfach nicht.
#
# WICHTIG, und NICHT im Code loesbar: Ein Browser-Schluessel ist immer
# oeffentlich sichtbar, auch aus der Umgebungsvariable — der Browser muss ihn
# kennen. Der Schutz kommt aus dem Google-Cloud-Konto:
#
#   1. Google Cloud Console > APIs & Dienste > Anmeldedaten > Schluessel waehlen
#   2. Anwendungseinschraenkungen > „Websites" > HTTP-Referrer eintragen:
#        https://k-aqua.de/*
#        https://www.k-aqua.de/*
#      (fuer Vorschau-Deployments zusaetzlich die jeweilige Domain)
#   3. API-Einschraenkungen > nur „Maps JavaScript API" zulassen
#   4. Abrechnung > Budget und Benachrichtigung setzen
#
# Ohne Schritt 2 ist der Schluessel von jeder fremden Seite aus verwendbar,
# auf Rechnung des Kontoinhabers.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Phase 2 — Headless CMS (optional; geo + product data are static TS modules today)
# CMS_API_URL=
# CMS_API_TOKEN=

# Phase 2 — RFQ / contact form delivery (today the form opens a mailto:)
# CONTACT_INBOX=info@k-aqua.de
# RESEND_API_KEY=

# Phase 2 — Analytics (none wired in the prototype)
# NEXT_PUBLIC_ANALYTICS_ID=
