# ── K-Aqua — Umgebungsvariablen ────────────────────────────────────────────
#
# Diese Datei nach `.env.local` kopieren und ausfuellen. `.env.local` ist
# gitignoriert und gehoert nirgendwo hin ausser auf den eigenen Rechner.
#
# FUER DEN BETRIEB: Dieselben Werte gehoeren in die Vercel-Umgebung, und zwar
# fuer Production UND Preview. Die vollstaendige Beschaffungsliste mit
# Begruendung steht in docs/UEBERGABE.md.
#
# ACHTUNG BEI NEXT_PUBLIC_*: Diese Werte werden zur BAUZEIT in das
# JavaScript-Buendel eingesetzt. Nach dem Eintragen in Vercel ist ein
# REDEPLOY noetig; blosses Speichern aendert am ausgelieferten Stand nichts.


# ═══ PFLICHT ═══════════════════════════════════════════════════════════════

# Basis-URL der Seite.
#
# Gelesen von lib/env.ts (getBaseUrl), das an 40 Stellen haengt: Canonicals,
# hreflang, sitemap.xml, robots.txt, OG-Bilder und saemtliche strukturierten
# Daten (JSON-LD).
#
# FEHLT SIE, bricht nichts — und genau das ist die Gefahr: lib/env.ts faellt
# dann auf die Vercel-Projektdomain zurueck, und die ganze Seite bezeichnet
# sich gegenueber Google als *.vercel.app. Kein Fehler, keine Warnung, nur
# eine still falsch indexierte Website.
NEXT_PUBLIC_SITE_URL=https://k-aqua.de


# Mailversand — Variante A: Resend  (EMPFOHLEN)
#
# Deckt Kontaktformulare UND Bewerbungen ab. Ein Schluessel, ein Dienst.
#
# So kommst du dran:
#   1. Konto auf resend.com anlegen
#   2. Domain k-aqua.de dort hinterlegen und die genannten DNS-Eintraege
#      setzen (SPF/DKIM). Ohne verifizierte Domain lehnt Resend den Versand
#      ab — der Selbsttest sagt das dann im Klartext.
#   3. API-Key erzeugen und hier eintragen
#
# OHNE MAILWEG meldet in Produktion jedes Formular einen Fehler. Das ist
# Absicht: Bis vor Kurzem meldeten die Formulare Erfolg und warfen die
# Anfrage weg. Ein sichtbarer Fehler ist besser als eine verlorene Anfrage.
RESEND_API_KEY=

# Absenderadresse. Die Domain MUSS bei Resend verifiziert sein.
MAIL_FROM=K-Aqua Website <noreply@k-aqua.de>


# Mailversand — Variante B: eigenes Postfach per SMTP
#
# Nur noetig, wenn Variante A nicht gewuenscht ist. Beide Wege koennen
# gleichzeitig gesetzt sein; Resend hat dann Vorrang.
#
# SMTP_PORT 587 mit SMTP_SECURE=false, oder 465 mit SMTP_SECURE=true.
# Port 25 wird von Vercel blockiert.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=


# ═══ OPTIONAL ══════════════════════════════════════════════════════════════

# Google Maps JavaScript API — Kartenbaustein auf /referenzen.
#
# Fehlt der Schluessel, bleibt der Kartenbereich leer; die Seite bleibt sonst
# fehlerfrei.
#
# NICHT IM CODE LOESBAR: Ein Browser-Schluessel ist immer oeffentlich sichtbar,
# auch aus der Umgebungsvariable — der Browser muss ihn kennen. Der Schutz
# kommt aus dem Google-Cloud-Konto:
#
#   1. Google Cloud Console > APIs & Dienste > Anmeldedaten > Schluessel waehlen
#   2. Anwendungseinschraenkungen > „Websites" > HTTP-Referrer eintragen:
#        https://k-aqua.de/*
#        https://www.k-aqua.de/*
#      (fuer Vorschau-Bereitstellungen zusaetzlich die jeweilige Domain)
#   3. API-Einschraenkungen > nur „Maps JavaScript API" zulassen
#   4. Abrechnung > Budget und Benachrichtigung setzen
#
# Ohne Schritt 2 ist der Schluessel von jeder fremden Seite aus verwendbar,
# auf Rechnung des Kontoinhabers.
#
# UND: Der bisherige Schluessel steht im Klartext in der Git-Historie
# (Commit 0fd00278). Er gehoert ersetzt, nicht nur beschraenkt.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=


# Empfaengeradressen. Ohne diese Zeilen gelten info@k-aqua.de und
# jobs@k-aqua.de. Mehrere Adressen kommagetrennt.
#
# Sinnvoll vor allem fuer Vorschau-Bereitstellungen: Ohne eigene Adresse
# schickt dort jeder Testklick eine echte Mail an den Vertrieb.
# MAIL_TO_LEADS=info@k-aqua.de
# MAIL_TO_JOBS=jobs@k-aqua.de


# Erzwingt den Konsolen-Mock, egal welche Zugangsdaten gesetzt sind.
# Fuer Vorschau-Bereitstellungen, auf denen nichts hinausgehen soll.
# MAIL_TRANSPORT=console


# Merkmal fuer GET /api/mail/selftest.
#
# Ohne diese Variable existiert der Endpunkt nicht (er antwortet mit 404).
# Ist sie gesetzt, laesst sich der Mailversand gegen die LIVE-Umgebung pruefen:
#
#   curl -H "x-mail-selftest-token: <WERT>" https://k-aqua.de/api/mail/selftest
#
# Eine lange Zufallszeichenkette waehlen.
# MAIL_SELFTEST_TOKEN=


# CRM-Anbindung. Jeder Lead wird zusaetzlich als JSON hierhin geschickt.
# Nimmt das CRM ihn an, gilt die Anfrage als erfasst -- auch wenn der
# Mailversand ausfaellt.
# CRM_WEBHOOK_URL=


# Notfall-Protokoll, wenn WEDER Mail NOCH CRM die Anfrage annehmen.
#
# BEWUSST AUS. Der Eintrag schreibt Name, Telefon und E-Mail in die Logs des
# Hosters (Aufbewahrung je nach Tarif, Serverstandort USA). Als letzter
# Rettungsanker vertretbar und besser als Datenverlust — aber es gehoert ins
# Verarbeitungsverzeichnis, und das ist eine Entscheidung des Auftraggebers.
# LEAD_NOTFALL_LOG=true


# ═══ NICHTS ZU BESCHAFFEN ══════════════════════════════════════════════════
#
# Diese Datei fuehrte frueher Platzhalter fuer CMS, Analytics und
# CONTACT_INBOX. Sie sind entfernt, weil sie IM CODE NIRGENDS GELESEN wurden
# und beim Einrichten in die Irre fuehrten:
#
#   CMS_API_URL / CMS_API_TOKEN — es gibt kein CMS. Produkt- und Geodaten
#                                 sind statische TypeScript-Module.
#   CONTACT_INBOX               — ersetzt durch MAIL_TO_LEADS.
#   NEXT_PUBLIC_ANALYTICS_ID    — es ist keine Reichweitenmessung eingebaut.
#                                 Der Einwilligungsdialog ist gebaut, aber
#                                 kein Dienst registriert. Das ist Absicht.
#
# Ebenso nicht eingebunden und damit nicht zu beschaffen: Sentry, Supabase,
# Algolia, Captcha-Dienste, Calendly, HubSpot, Mailchimp.
