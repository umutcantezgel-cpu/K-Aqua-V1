,
    "electrofusion-machine": {
      "seo_p1": "Elektrosveisemaskinen (Electrofusion Machine) er en høyteknologisk styreenhet for sikker sammensmelting av elektrosveisefittings i store PP-R-prosjekter.",
      "seo_p2": "Gjennom en helautomatisk prosess med strekkodeleser gjenkjenner maskinen fittingstypen og omgivelsestemperaturen, og kalibrerer strømstyrken og sveisesyklusen nøyaktig.",
      "seo_p3": "Dette garanterer reproduserbare, 100 % tette sveisesømmer uavhengig av operatørens ferdigheter – et absolutt must for sikkerhetskritiske rørledningsnett og sjakter.",
      "faq": [
        {
          "q": "Må maskinen kalibreres regelmessig?",
          "a": "Ja, i likhet med alle presisjonsinstrumenter krever våre maskiner et årlig kalibrerings- og vedlikeholdsintervall for å oppfylle strenge industristandarder."
        },
        {
          "q": "Hva skjer hvis strømmen svikter under sveisingen?",
          "a": "Maskinen avbryter prosessen og registrerer feilen. Fittingen må kjøles ned og kasseres, da en delvis sveising ikke er trykksikker."
        },
        {
          "q": "Registrerer maskinen hver sveisesøm for dokumentasjon?",
          "a": "Ja, enheten lagrer alle sveiseprotokoller med tidsstempel og parametere, som kan leses ut via USB for byggeplassrevisjonen."
        }
      ]
    },
    "electrofusion-socket": {
      "seo_p1": "Elektrosveisemuffen (Electrofusion Socket) er premiumløsningen for tilkoblinger der tradisjonell muffesveising ikke er mulig på grunn av plassmangel.",
      "seo_p2": "Utstyrt med integrerte varmetråder av en spesiell legering, smelter dette PP-R-beslaget automatisk og datastyrt sammen med basisrøret.",
      "seo_p3": "Ideell for reparasjonsarbeid i sjakter, ettermonterte utvidelser eller ekstremt vanskelig tilgjengelige områder; den tilbyr en 100 prosent sikker og dokumenterbar tilkobling.",
      "faq": [
        {
          "q": "Må røret skrelles før elektrosveising?",
          "a": "Ja, fjerning av oksidlaget med et spesielt rørskrellevertøy er absolutt nødvendig for en feilfri sammensmelting."
        },
        {
          "q": "Hvilke sveiseapparater kan brukes?",
          "a": "Det må brukes K Aqua eller universelle elektrosveiseapparater som kan lese strekkoden på muffen."
        },
        {
          "q": "Når er elektrosveising bedre enn varmeelement-muffesveising?",
          "a": "Spesielt ved begrenset bevegelsesfrihet (f.eks. i en sjakt), der det ikke er plass til verktøyet for muffesveising."
        }
      ]
    },
    "elongation-pieces": {
      "seo_p1": "Forlengelsesstykket (Elongation Piece) brukes til nøyaktig utvidelse av gjengeforbindelser ved vegginstallasjoner med variabel dybde.",
      "seo_p2": "Dette massive messingbeslaget avlaster PP-R-installasjonen i veggen ved dype puss- eller flislag, og sikrer en stødig armaturtilkobling.",
      "seo_p3": "Et uunnværlig verktøy på byggeplassen for å utligne byggetoleranser i etterkant, uten at veggelementet bak flisen må brytes opp igjen.",
      "faq": [
        {
          "q": "I hvilke lengder er forlengelsene tilgjengelige?",
          "a": "De er tilgjengelige i ulike, standardiserte lengder (f.eks. 15 mm, 20 mm, 30 mm) for å kunne reagere fleksibelt på pussdybden."
        },
        {
          "q": "Påvirker en forlengelse vannkvaliteten?",
          "a": "Nei, vi bruker kun kvalitetsmessing godkjent for drikkevann for å overholde hygienekravene."
        },
        {
          "q": "Må gjengene til forlengelsen tettes spesielt?",
          "a": "Ja, akkurat som enhver gjengeforbindelse, må både inn- og utskruingssiden tettes fagmessig med teflonteip."
        }
      ]
    },
    "flange-adaptor": {
      "seo_p1": "Kragehylsen (Flange Adaptor) fungerer som et viktig forbindelseselement for å koble plastrør sikkert og demonterbart til metalliske flenser eller armaturer.",
      "seo_p2": "PP-R-komponenten er formet for å gi perfekt passform for løsflenser og overfører det høye kontakttrykket jevnt til pakningen.",
      "seo_p3": "Uunnværlig i industrielle rørledningssystemer og ved store fordeleranlegg. Kragehylsen muliggjør en sikker overgang til pumper, store ventiler og stålsystemer.",
