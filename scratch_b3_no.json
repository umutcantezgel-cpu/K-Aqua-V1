        {
          "q": "Trenger pakningen smøremiddel før montering?",
          "a": "Nei, flatpakninger for flenser monteres tørre og rene. Fett eller pasta kan føre til at pakningen sklir ut under trykk."
        }
      ]
    },
    "flat-gasket-for-unions-pp-r": {
