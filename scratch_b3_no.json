        },
        {
          "q": "Trenger jeg en ekstra pakning?",
          "a": "Ja, det må alltid legges en passende EPDM-flatpakning mellom PP-R-kragehylsen og motflensen."
        },
        {
          "q": "Hvordan kobles kragehylsen til røret?",
          "a": "Den sveises som en vanlig fitting, direkte på røret eller inn i en muffe via varmeelement-muffesveising."
        }
      ]
    },
    "flat-gasket": {
      "seo_p1": "Flatpakningen (Flat Gasket) er det sentrale tetningselementet for sikre og lekkasjefrie flensforbindelser i industrielle rørledningsnett.",
      "seo_p2": "Laget av høykvalitets elastomer (som EPDM eller NBR), kompenserer den for mikroskopiske ujevnheter mellom kragehylsen og metallmotflensen under høyt press.",
      "seo_p3": "Den garanterer permanent tetthet, selv ved vibrasjoner fra pumper eller store temperatursvingninger i klimaanlegg.",
      "faq": [
        {
          "q": "Kan flatpakningen gjenbrukes etter demontering?",
