        {
          "q": "Hvordan forsegler jeg midlertidige ledninger?",
          "a": "For midlertidige avstengninger anbefaler vi plugger med gjenger; endehetten sveises homogent og er dermed beregnet for permanent forsegling."
        },
        {
          "q": "Er endehetten tett ved alle temperaturer?",
          "a": "Gjennom den termiske sammensmeltingen finnes det ingen ulike utvidelseskoeffisienter, noe som gjør at den forblir absolutt lekkasjefri fra 0 °C til 95 °C."
        }
      ]
    },
    "concealed-valve-chrome-heavy-part": {
      "seo_p1": "Den skjulte ventilen i tung utførelse (Concealed Valve Chrome Heavy Part) tilbyr en førsteklasses og robust avstengningsløsning direkte i veggen.",
      "seo_p2": "Med en massiv messingkjerne innkapslet i trykkfast PP-R, garanterer den lang levetid og presis regulering av vannstrømmen. Den forkrommede overflaten sørger for et elegant utseende i det synlige området.",
      "seo_p3": "Ideell for høykvalitets sanitærinstallasjoner på hoteller og luksuriøse boliger, der holdbarhet og estetikk må gå hånd i hånd.",
      "faq": [
        {
          "q": "Hva skiller den \"tunge\" utførelsen fra den \"lette\"?",
          "a": "Den tunge utførelsen har en mer massiv messingkjerne og et sterkere håndtak, noe som gir den lengre levetid ved hyppig bruk og under høye trykk."
        },
        {
          "q": "Er ventilen vedlikeholdsfri?",
          "a": "Selv om de interne komponentene er svært slitesterke, kan kranoverdelen (spindelen) enkelt byttes ut ved behov uten å bryte rørforbindelsen i veggen."
        },
        {
          "q": "Kan den monteres under fliser?",
          "a": "Ja, selve ventilkroppen monteres under puss, kun det forkrommede håndtaket og rosetten er synlige etter flislegging."
        }
      ]
    },
    "concealed-valve-chrome-light-part": {
      "seo_p1": "Den skjulte ventilen i lett utførelse (Concealed Valve Chrome Light Part) er den kostnadseffektive løsningen for pålitelige avstengninger under puss.",
      "seo_p2": "Den kombinerer den beviste K Aqua PP-R teknologien for lekkasjefrie rørtilkoblinger med en lett og funksjonell messingoverdel og en attraktiv kromrosett.",
      "seo_p3": "Perfekt for standardinstallasjoner i private bad, der funksjonalitet og et rent, skjult utseende er i fokus.",
