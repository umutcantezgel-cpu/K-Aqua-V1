    "adaptor-socket-female-thread": {
      "seo_p1": "Overgangsmuffen med innvendige gjenger (Adaptor Socket Female Thread) danner et viktig grensesnitt mellom det sveisede PP-R-rørsystemet og metalliske gjengekomponenter.",
      "seo_p2": "Den kombinerer en robust PP-R muffekropp med en høykvalitets metallinnsats (innvendig gjenge). Dette sikrer utmerket trykkbestandighet ved standard SDR-nivåer.",
      "seo_p3": "Denne fittingen er uunnværlig ved tilkobling av armaturer, manometre og spesialventiler i bygningsinstallasjoner, for å garantere varig dryppfrie overganger.",
      "faq": [
        {
          "q": "Hva brukes monteringsplaten til?",
          "a": "Den integrerte platen med borehull tillater stiv, mekanisk fiksering av vinkelen direkte til veggen eller et monteringselement."
        },
        {
          "q": "Er metallgjengene utsatt for korrosjon?",
          "a": "Nei, metallinnsatsene er laget av høykvalitets, avsinkningsbestandig messing og er derfor svært korrosjonsbestandige."
        },
        {
          "q": "Kan jeg tette gjengene med hamp?",
          "a": "Vi anbefaler bruk av teflonteip (PTFE-teip). Hamp skal kun brukes svært sparsomt og med en ikke-svellende pasta for å unngå å sprenge messinginnsatsen."
        }
      ]
    },
    "adaptor-socket-male-thread": {
      "seo_p1": "Overgangsmuffen med utvendige gjenger (Adaptor Socket Male Thread) muliggjør en fast og sikker tilkobling av PP-R-nettverket til videre metalliske rørledninger.",
      "seo_p2": "En uttrekkssikker forankring av den utvendige messinggjengen i den høyfaste polypropylenkroppen forhindrer vridning og garanterer ekstrem levetid ved store temperatur- og trykksvingninger.",
      "seo_p3": "Ofte brukt ved tilkobling av kjeler, varmepumper eller filtre, sikrer denne muffen en holdbar og standardkompatibel gjengeforbindelse.",
      "faq": [
        {
          "q": "Er den innvendige gjengen utelukkende av messing?",
          "a": "Ja, den innvendige gjengen er en massiv messinginnsats av høy kvalitet som er injisert fast og vrisikkert inn i PP-R-materialet."
        },
        {
          "q": "Kan forbindelsen løsnes ved behov?",
          "a": "Ja, metallgjengen gjør det til enhver tid mulig å demontere tilkoblet utstyr som pumper eller filtre på en sikker måte."
        },
        {
          "q": "Hva er maksimalt tiltrekkingsmoment?",
          "a": "Gjengene bør strammes med standardverktøy og følelse for å unngå spenningssprekker i den tilstøtende plasten."
        }
      ]
    },
    "adjustable-battery-female-thread": {
      "seo_p1": "Det justerbare fordelerbatteriet med innvendige gjenger (Adjustable Battery Female Thread) tilbyr maksimal fleksibilitet ved installasjon av veggmonterte armaturer.",
      "seo_p2": "Laget av stabilt PP-R med metallgjengeinnsatser, tillater det nøyaktig justering av stikkmålet (avstanden) for å kompensere for byggetoleranser før endelig fiksering.",
      "seo_p3": "Ideelt for presis installasjon av dusj- og badekararmaturer. Den variable monteringsplaten garanterer et spenningsfritt og visuelt perfekt resultat på veggen.",
      "faq": [
        {
          "q": "Hvorfor er et justerbart batteri fordelaktig?",
          "a": "Det tillater millimeterpresis justering av gjengeavstanden etter rørlegging, for å passe perfekt til den valgte armaturen."
        },
        {
          "q": "Kan stikkmålet standardiseres?",
          "a": "Ja, de fleste installasjoner krever et standard stikkmål på 150 mm, som enkelt kan stilles inn og låses med dette batteriet."
        },
        {
          "q": "Trengs det spesielle festemidler?",
          "a": "Platen skrus fast til underlaget med standard skruer; de medfølgende slissene gir den nødvendige justeringsmarginen."
        }
      ]
    },
    "backing-flange-pp-steel-sfbf": {
      "seo_p1": "Løsflensen (Backing Flange PP/Steel SFBF) er den robuste motparten for flensforbindelser i K Aqua-systemet, designet for de høyeste industrielle trykk.",
      "seo_p2": "Den består av en høyfast stålkjerne belagt med PP for å sikre optimal korrosjonsbeskyttelse og mekanisk motstandskraft i tøffe miljøer.",
      "seo_p3": "Brukt i kombinasjon med våre kragehylser, muliggjør flensen sikker montering av tunge industriventiler, pumper og overganger til rørledninger i stål eller støpejern.",
      "faq": [
        {
          "q": "Hvorfor er stålkjernen belagt med PP?",
          "a": "Plastbelegget beskytter stålet mot ytre korrosjon og aggressive miljøer, slik at flensen varer like lenge som rørsystemet."
        },
        {
          "q": "Passer flensen til standard DIN-hullmønstre?",
          "a": "Ja, boringene og dimensjonene samsvarer nøyaktig med internasjonale standarder (f.eks. PN 10/PN 16) for enkel systemintegrasjon."
        },
        {
          "q": "Må skruene strammes på en spesiell måte?",
          "a": "Skruene bør alltid strammes kryssvis med et momentnøkkel til spesifisert moment, for å sikre jevnt trykk på EPDM-pakningen."
        }
      ]
    },
    "battery-female-thread": {
      "seo_p1": "Det faste fordelerbatteriet med innvendige gjenger (Battery Female Thread) er standardkomponenten for rask og pålitelig tilkobling av dobbeltarmaturer.",
      "seo_p2": "Dette formstøpte PP-R-beslaget har et fastsatt, normert stikkmål (vanligvis 150 mm) med to integrerte messing-innvendige gjenger og solide festepunkter.",
      "seo_p3": "Perfekt for serieproduksjon av våtrom og prefabrikkerte installasjonsvegger, garanterer det en vridningssikker montering uten ekstra innstillingsarbeid.",
      "faq": [
        {
          "q": "Hva er den største fordelen i forhold til det justerbare batteriet?",
          "a": "Det faste batteriet er raskere å installere, da stikkmålet er fabrikkinnstilt og ikke kan forskyves under monteringen."
        },
        {
          "q": "Tåler beslaget vekten av tunge blandebatterier?",
          "a": "Ja, takket være den massive monteringsplaten og de dype messinginnsatsene, forankres selv tunge armaturer sikkert."
        },
        {
          "q": "Kan tilkoblingene byttes om?",
          "a": "Ved installasjon må varmt- og kaldtvannstilkoblingene monteres nøyaktig iht. spesifikasjonene (kaldt til høyre, varmt til venstre)."
        }
      ]
    },
    "butt-welding-machine-90250": {
      "seo_p1": "Stumpsveisemaskinen (Butt Welding Machine 90-250) er det essensielle presisjonsverktøyet for tilkobling av store K Aqua PP-R og PPRCT rør.",
      "seo_p2": "Denne robuste maskinen støtter dimensjoner fra 90 mm til 250 mm og muliggjør en hydraulisk styrt, millimeterpresis justering av rørendene.",
      "seo_p3": "Ved å fjerne muffen og smelte rør- og fittingender direkte mot hverandre, sikres en ekstremt sterk, homogen sveisesøm for tunge industrielle applikasjoner og hovedledninger.",
      "faq": [
        {
          "q": "Trengs det spesielle fittings for stumpsveising?",
          "a": "Ja, det kreves spesielle \"spissende\" fittings (Spigot fittings), som har nøyaktig samme diameter og veggtykkelse som røret."
        },
        {
          "q": "Er sveiseparameterne vanskelige å stille inn?",
          "a": "Maskinen leveres med detaljerte tabeller (eller digital styring) for oppvarmings-, omstillings- og avkjølingstider iht. DVS-retningslinjene."
        },
        {
          "q": "Er sømmen virkelig like sterk som selve røret?",
          "a": "Ja, når sveiseprosedyren følges korrekt, oppnår stumpsveisesømmen en strekk- og trykkfasthet på 100 % sammenlignet med det opprinnelige røret."
        }
      ]
    },
    "cap": {
      "seo_p1": "Endehetten (Cap) er en uunnværlig fitting i vårt sortiment, designet for en varig og sikker avslutning av rørender.",
      "seo_p2": "Laget av høykvalitets PP-R-materiale, tilsvarer hetten de vanlige SDR-klassene for rør og tilbyr maksimal trykkbestandighet og dimensjonsnøyaktighet for en homogen sveising.",
      "seo_p3": "Den er ideell for permanent eller midlertidig avstengning av rørstrekk i drikkevanns- og varmesystemer, og garanterer en absolutt lekkasjefri og vedlikeholdsfri forsegling.",
      "faq": [
        {
          "q": "Kan endehetten brukes til trykktesting?",
          "a": "Ja, etter riktig sveising og avkjøling tåler endehetten fullt prøvetrykk for systemet (opptil 30 bar) uten problemer."
