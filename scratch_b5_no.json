    "pipe-clamps": {
      "seo_p1": "Rørklemmene (Pipe Clamps) er mekaniske festeelementer som sikrer stabil og spenningsfri montering av K Aqua-rørsystemet på vegg eller i tak.",
      "seo_p2": "Disse klemmene er nøyaktig tilpasset den ytre diameteren på PP-R-rør og leveres typisk med gummiinnlegg (lydisolering) for å tillate lineær ekspansjon.",
      "seo_p3": "De forhindrer overføring av strukturbåren lyd, sikrer tilstrekkelige festepunkter, og leder kontrollert rørets termiske bevegelse mot ekspansjonskompensatorer.",
      "faq": [
        {
          "q": "Finnes det spesifikke avstander for rørklemmer?",
          "a": "Ja, festeavstandene avhenger av rørdiameter og rørets type (standard vs. fiber). Detaljer finnes i våre installasjonsretningslinjer."
        },
        {
          "q": "Hva er forskjellen på faste punkter (Fixed point) og glidende punkter (Sliding point)?",
          "a": "Faste punkter låser røret stramt på plass, glidende punkter tillater aksiell termisk bevegelse innenfor gummipakningen."
        },
        {
          "q": "Hvorfor er gummipakningen viktig?",
          "a": "Den reduserer støyoverføring til bygningsstrukturen betydelig og beskytter rørets overflate mot gnaging ved utvidelser."
        }
      ]
    },
    "pipe-cutter-2040": {
