,
    "k-pipe-purple-pp-r-sdr-11": {
      "seo_p1": "Det fiolettfargede K-Pipe Purple PP-R SDR 11 brukes for tydelig merking av spesifikke rørsystemer. Det forhindrer forveksling ved installasjon av adskilte vannkretser.",
      "seo_p2": "Den fiolette signalfargen indikerer normalt driftsvann, regnvann eller vanningssystemer. Teknisk tilsvarer det standard PP-R med SDR 11 (1,2 MPa ved 20 °C) og tilbyr den samme høye kvaliteten.",
      "seo_p3": "Ved å bruke dette spesialrøret økes anleggets sikkerhet, og en standardkompatibel atskillelse mellom drikke- og bruksvann sikres visuelt. Perfekt for bærekraftige vannforvaltningssystemer.",
      "faq": [
        {
          "q": "Hva representerer den fiolette fargen?",
          "a": "Den tjener til visuell differensiering av rørsystemer for driftsvann, gråvann eller regnvann, i henhold til internasjonale retningslinjer."
        },
        {
          "q": "Kan røret sveises med vanlige PP-R fittings?",
          "a": "Ja, det fiolette røret er kompatibelt med alle K Aqua standardfittings og sveises med de samme parametrene."
        },
        {
          "q": "Påvirker fargen materialkvaliteten?",
          "a": "Nei, de fysiske og kjemiske egenskapene er identiske med det vanlige PP-R SDR 11-røret."
        }
      ]
    },
    "metal-union-female-thread": {
      "seo_p1": "Metall-unionen med innvendige gjenger (Metal Union Female Thread) muliggjør en trykksikker, men løsbar overgang mellom PP-R-nettverket og gjengede komponenter.",
      "seo_p2": "Dette 3-delte beslaget kombinerer en sveisbar PP-R-del med en messinggjenge og en overfalsmutter, forseglet av en motstandsdyktig EPDM-flatpakning.",
      "seo_p3": "Den er uunnværlig for komponenter som krever regelmessig vedlikehold, som sirkulasjonspumper, filtre eller ventiler, og garanterer en lekkasjefri, raskt demonterbar tilkobling.",
      "faq": [
        {
          "q": "Må flatpakningen byttes etter demontering?",
          "a": "Vi anbefaler alltid å bytte ut EPDM-pakningen med en ny for å sikre 100 % tetthet etter ny montering."
        },
        {
          "q": "Er gjengen belagt for korrosjonsbeskyttelse?",
          "a": "Ja, denne messingkomponenten er overflatebehandlet for å sikre lang levetid i krevende bygningsinstallasjoner."
        },
        {
          "q": "Kan skrukoblingen løsne ved vibrasjoner?",
          "a": "Overfalsmutteren danner en mekanisk låst forbindelse som holder tett selv under pumpevibrasjoner når den er strammet riktig."
        }
      ]
    },
    "metal-union-female-thread-yellow-brass": {
      "seo_p1": "Metall-unionen med innvendige gjenger i gul messing (Metal Union Female Thread Yellow Brass) er den ubelagte, blyfrie varianten for de strengeste hygienekrav.",
      "seo_p2": "Laget av spesialmessing i sin naturlige form, oppfyller denne skrukoblingen de strengeste internasjonale retningslinjene for drikkevann. En EPDM-pakning sørger for absolutt tetthet.",
      "seo_p3": "Den brukes først og fremst i sykehus eller høykvalitets matvareinstallasjoner der løsbare koblinger må implementeres uten overflatebelegg.",
      "faq": [
        {
          "q": "Hvorfor velge ubelagt gul messing fremfor forkrommet?",
          "a": "Spesielt i henhold til UBA-retningslinjer (Tyskland) kan ubelagt messing være å foretrekke i sensitive drikkevannssystemer for å utelukke enhver innblanding av beleggstoffer."
