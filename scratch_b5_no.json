        },
        {
          "q": "Tåler komponenten varme termiske desinfeksjoner?",
          "a": "Ja, både messingkomponenten og EPDM-pakningen tåler regelmessige termiske desinfeksjonssykluser ved høye temperaturer."
        }
      ]
    },
    "metal-union-male-thread": {
      "seo_p1": "Metall-unionen med utvendige gjenger (Metal Union Male Thread) er den perfekte motparten for løsbare tilkoblinger til komponenter med innvendige gjenger.",
