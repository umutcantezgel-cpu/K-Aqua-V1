    },
    "hand-welding-machine-mirror-50125": {
      "seo_p1": "Varmeelementspeilet for 50-125 mm (Hand Welding Machine Mirror) tilbyr maksimal kontaktflate for oppvarming av store dimensjoner.",
      "seo_p2": "Denne spesielle, flate varmeplaten sørger for at de massive rørendene og mufferadiene i industrielle dimensjoner blir jevnt oppvarmet til smeltetemperaturen.",
      "seo_p3": "Speilet er hjertet i storrør-installasjoner og er uunnværlig i kombinasjon med våre mekaniske sveiseinnretninger for kjøle- og fjernvarmenettverk.",
      "faq": [
