    "union": {
      "seo_p1": "Fullplast-unionen (Union) er en tre-delt skrukobling i polypropylen, designet for fleksible og demonterbare rørforbindelser uten metallkomponenter.",
      "seo_p2": "Den består av to sveiseender og en PP-overfalsmutter som klemmer en elastomer-flatpakning, og tilbyr samme trykkfasthet som standard PP-R røret.",
      "seo_p3": "Spesielt brukt i industrielle applikasjoner for transport av ultrarent vann eller kjemikalier, der enhver metallkontakt er strengt forbudt.",
      "faq": [
        {
          "q": "Hvorfor bruke en fullplast-union i stedet for messing?",
          "a": "Når mediet (som syrer eller kjemikalier) ville angripe metall, eller ved transport av demi-vann, garanterer full plast 100 % metallfri sikkerhet."
        },
        {
          "q": "Hvordan strammer jeg plastmutteren?",
          "a": "Mutteren skal strammes for hånd og eventuelt strammes svært forsiktig med en reimnøkkel. En metallrørtang vil ødelegge polypropylenet."
        },
        {
          "q": "Hvilket trykk tåler plastgjengene?",
          "a": "Plastgjengene er grovt støpt og dimensjonert for å trygt håndtere PN 20 driftstrykk ved romtemperatur."
        }
      ]
    },
    "union-for-watermeters": {
      "seo_p1": "Vannmåler-koblingen (Union for Watermeters) er spesielt utformet for den sikre og rombesparende installasjonen av standardiserte forbruksmålere i bygningsdistribusjonen.",
      "seo_p2": "Laget av PP-R for direkte sammensmelting i rørsystemet, med en integrert messinggjengemutter og en tetningsring dimensjonert nøyaktig for de flate anleggsflatene til vannmålere.",
      "seo_p3": "Den muliggjør det enkle, årlige byttet av måleren uten å stresse rørsystemet. Dette garanterer nøyaktighet for kommunale standarder og lang levetid.",
      "faq": [
        {
          "q": "Følger tetningsringen med?",
          "a": "Ja, en passende flatpakning som bygger perfekt overgang til metalloverflaten på måleren, er alltid inkludert i K Aqua sine vannmåler-koblinger."
        },
        {
          "q": "Passer denne til alle vannmålere?",
          "a": "Den er laget for å passe de standardiserte rørgjengene (f.eks. 3/4\" eller 1\") som finnes på kommersielle målere."
        },
        {
          "q": "Hvorfor ikke bare bruke en standard metallunion?",
          "a": "Vannmåler-koblingen er dimensjonert kortere og flensmålene er maskinert eksakt for målerhus, for å unngå turbulens som forstyrrer målingen."
        }
      ]
    },
    "weld-in-saddle": {
      "seo_p1": "Den innsveisede sadelen (Weld-in Saddle) i PP-R endrer spillereglene for ettermontering og avstikkere i store rørnettverk.",
      "seo_p2": "I stedet for å kutte hovedrøret og sette inn tre store T-muffer, bores et lite hull i hovedrøret. Sadelen varmes deretter opp og smeltes direkte inn i og utenpå rørveggen.",
      "seo_p3": "Dette reduserer monteringstiden, sparer enormt mye plass og materiale i sjakten, og reduserer kostnadene for industrielle kjøle- og varmenettverk dramatisk.",
      "faq": [
        {
          "q": "Er en sadel like sterk som et normalt T-stykke?",
          "a": "Ja, med riktige sveisedyser og temperatur smelter sadelen og hovedrøret sammen og oppnår 100 % trykkfasthet til det originale røret."
        },
        {
          "q": "Kan det utføres mens røret er under trykk (Hot tapping)?",
          "a": "Nei. Røret må bores og polyfusjon krever absolutte tørre forhold. Systemet må stenges og tappes først."
        },
        {
          "q": "Kreves det spesialverktøy?",
          "a": "Ja, du trenger K Aqua-boreverktøyet for nøyaktig hullstørrelse, og sadelsveisedysene som speiler kurven til hovedrøret."
        }
      ]
    },
    "weld-in-saddle-female-thread": {
      "seo_p1": "Den innsveisede sadelen med innvendige gjenger (Weld-in Saddle Female Thread) tillater direkte påkobling av sensorer eller metallventiler på store PP-R stamledninger.",
      "seo_p2": "Kombinerer den revolusjonerende sadelsveisingen (ingen rørkutting) med en robust, avsinkningsbestandig messing-innvendig gjenge for direkte metalltilkoblinger.",
      "seo_p3": "Det ideelle valget for å plassere manometre, termometre, eller tappeventiler rett på en sirkulerende fjernvarmelinje uten materialsløsing.",
      "faq": [
        {
          "q": "Er det fare for at plastveggen svekkes rundt hullet?",
          "a": "Tvert imot: Den doble sammensmeltingen (inni hullet og rundt overflaten) bygger opp ekstra veggtykkelse på avstikkpunktet."
        },
        {
          "q": "Kan man montere tunge armaturer på denne sadelen?",
          "a": "Sadelen er utrolig sterk, men for svært tunge motoriserte ventiler anbefales en egen mekanisk rørstøtte for å hindre vektstang-effekter."
        },
        {
          "q": "Hva er den typiske gjengedimensjonen?",
          "a": "De leveres typisk i små gjengedimensjoner (som 1/2\" og 3/4\") fordi de primært brukes til overvåkingsutstyr."
        }
      ]
    },
    "weld-in-saddle-male-thread": {
      "seo_p1": "Den innsveisede sadelen med utvendige gjenger (Weld-in Saddle Male Thread) er raskeste vei fra et stort plastrør til et komponent med innvendige metallgjenger.",
      "seo_p2": "Den smelter sømløst inn i utsiden av hovedrøret og tilbyr en massiv, høykvalitets utvendig messinggjenge. Den sparer både kutt og plasskrevende store T-stykker.",
      "seo_p3": "Perfekt i utstyrssentraler der filtre eller ekspansjonskar må integreres direkte på det overdimensjonerte manifold-systemet i PP-R.",
      "faq": [
        {
          "q": "Må overflaten til røret rengjøres før sveising?",
          "a": "Absolutt, røroverflaten må slipes rent, være 100 % fri for smuss og tørr for at sadelen skal smelte jevnt inn."
        },
        {
          "q": "Kan man montere denne sadelen på et fiberrør?",
          "a": "Ja, K Aqua sadelprogrammet fungerer utmerket også med fiberrør; boringsprosessen trenger gjennom fiberlaget problemfritt."
        },
        {
          "q": "Hvordan vet man når man har varmet lenge nok?",
          "a": "Sadelsveiseverktøyet trykkes ned inntil det når stoppmerket, og holdes der iht. tidstabellen i manualen."
        }
      ]
    },
    "welding-machine-50125-complete-set": {
      "seo_p1": "Den stasjonære sveisemaskinen 50-125 (Welding Machine Complete Set) bringer fabrikkpresisjon direkte ut til byggeplassen for store rørdimensjoner.",
      "seo_p2": "Designet med et mekanisk, tannhjulstyrt glidesystem for å garantere at rør og fitting møtes med eksakt parallellitet og presskraft, langt utover hva menneskelig styrke klarer.",
      "seo_p3": "Uunnværlig for feilfrie polyfusjonssveisinger på dimensjoner over 63 mm, spesielt i rørledningsbygging der vinkelfeil kan koste titusenvis av kroner.",
      "faq": [
        {
          "q": "Er det virkelig umulig å sveise en 90 mm for hånd?",
          "a": "Det frarådes sterkt. Tiden for omstilling og kraften som trengs for å dytte et varmt 90 mm rør i en muffe er enorm. Maskinen sikrer kvaliteten."
        },
        {
          "q": "Krever maskinen strøm?",
          "a": "Selve klemme- og pressemekanismen betjenes manuelt (mekanisk sveiv). Det er kun det integrerte varmeelementspeilet som krever 230V strøm."
        },
        {
          "q": "Følger klemmene med for alle dimensjoner?",
          "a": "Settet leveres med reduksjonsklemmer og støtteruller, slik at den maskinen raskt kan bytte fra å sveise 125 mm helt ned til 50 mm rør."
        }
      ]
    },
    "welding-tool": {
      "seo_p1": "Sveisedysene / verktøyet (Welding Tool) er de essensielle teflonbelagte matrisene (hunn) og patrisene (hann) for varmeelement-muffesveising.",
      "seo_p2": "Disse dysene leder varmen (260 °C) med ekstrem presisjon. Patrisen smelter den indre veggen til muffen, mens matrisen smelter den ytre overflaten til røret, alt innen definerte DVS-toleranser.",
      "seo_p3": "Høykvalitets non-stick teflonbelegg sikrer at ingen plast blir igjen på verktøyet. Presisjonen i formen er direkte ansvarlig for tettheten til hver eneste sammenføyning.",
      "faq": [
        {
          "q": "Når vet man at dysen er utslitt?",
          "a": "Når teflonbelegget begynner å skalle av og smeltet plast (PP-R) begynner å feste seg fast til overflaten, bytt den ut umiddelbart."
        },
        {
          "q": "Kan dyser fra andre produsenter brukes?",
          "a": "Dimensjonene på verktøyet og oppvarmingstoleransene er ekstremt kalibrerte til K Aqua-rørene. Uoriginale dyser kan føre til trykkfeil."
        },
        {
          "q": "Hvordan rengjøres dysene under arbeid?",
          "a": "De bør tørkes med en ren og lofri bomullsklut mellom sveiseoperasjonene mens de er varme. Aldri vask med vann."
        }
      ]
    },
    "welding-tool-for-repairing-plug": {
      "seo_p1": "Sveiseverktøyet for reparasjonsplugger (Welding Tool for Repairing Plug) er skreddersydd for å fikse borehull i rør uten utskifting.",
      "seo_p2": "Denne spesialdysen har en lang og tynn varmestift som smelter innsiden av det ødelagte hullet i rørveggen, samtidig som baksiden av dysen smelter selve PP-R fyllpluggen.",
      "seo_p3": "Verktøyet er uerstattelig når uhellet er ute under grovbyggefasen, og redder hele installasjonen ved å sørge for en presis molekylær sammensmelting ved skadepunktet.",
      "faq": [
        {
          "q": "Kan man bruke et standard verktøy for dette?",
          "a": "Nei, designet krever nøyaktig kalibrering til pluggens koniske form for å fylle borehullet jevnt ut."
        },
        {
          "q": "Er verktøyet dekket av teflon?",
          "a": "Ja, i likhet med alle våre sveisedyser har også reparasjonsverktøyet et slitesterkt teflonbelegg."
        },
        {
          "q": "Hvilken sveisetemperatur brukes ved reparasjon?",
          "a": "Sveisetemperaturen holdes på standard 260 °C, nøyaktig som ved all annen PP-R rør- og muffesveising."
        }
      ]
    },
    "welding-tool-for-weld-in-saddles": {
      "seo_p1": "Sveiseverktøyet for innsveisede sadler (Welding Tool for Weld-in Saddles) er det unike teflon-støpte paret som gjør sadel-innovasjonen mulig.",
      "seo_p2": "I stedet for flate former har patrisen en hul kurvatur (for å smelte utsiden av hovedrøret), og matrisen varmer opp hullet i hovedveggen, mens det motsatte parret smelter sadelens sokkel.",
      "seo_p3": "Dette verktøyet produserer perfekte avstikkere (T-stykker) etter-montert. Det sparer tusenvis av kroner på store fittings ved distribusjonsbygging.",
      "faq": [
        {
          "q": "Trenger jeg et unikt verktøy for hver rørstørrelse?",
          "a": "Verktøyet må matche både diameteren på hovedrøret (kurvaturen) og diameteren på sadel-avstikkeren."
        },
        {
          "q": "Kan det skrus fast på vanlige håndsveisemaskiner?",
          "a": "Ja, sadelsveiseverktøy kan monteres på de normale K Aqua flate sveisespeilene eller håndsveisemaskinene ved hjelp av monteringsskruen."
        },
        {
          "q": "Hvorfor er verktøyet gradert?",
          "a": "Det finnes ofte merkelinjer på verktøyet for å gi installatøren en visuell indikasjon på at materialet har nådd riktig dybde og smeltetid."
        }
      ]
    }
