!.vscode/extensions.json
.idea

# vercel
.vercel

# ---------------------------------------------------------------------------
# Generierungs-/Scratch-Artefakte
#
# Hintergrund: Das Repo enthielt ~3.000 Dump- und Skriptdateien aus früheren
# KI-Generierungsläufen. Die Regeln unten fangen typische Muster ab, BEVOR sie
# eingecheckt werden. Wichtig: .gitignore wirkt nur auf noch nicht getrackte
# Dateien — bereits getrackte müssen mit `git rm --cached` entfernt werden.
# ---------------------------------------------------------------------------

# Einmal-Skripte im Repo-Root (echte Skripte gehören nach scripts/)
/*.js
/*.py
/*.mjs
/*.cjs
!/eslint.config.mjs
!/postcss.config.mjs

# Daten-Dumps und Zwischenstände im Repo-Root
/*.txt
/*.json
/*.jsonl
/*.html
/*.part
!/package.json
!/package-lock.json
!/tsconfig.json
!/components.json

# Videos gehören nach public/videos/ (die sind getrackt und werden ausgeliefert).
# Streuner in public/images/ nicht committen — dort liegt u. a. eine 146-MB-Datei,
# die von keiner Seite referenziert wird.
public/images/**/*.mp4

# Scratch-Ordner
/scratch/
/scratch_chunks/
/temp_de_chunks/
/tmp/
/export-*/
/.agents/

# Interne Dokumente — niemals ausliefern oder committen
docs/confidential/

# ---------------------------------------------------------------------------
# messages/: ALLE Sprachdateien werden getrackt (Deployment braucht sie).
# Nur Generierungs-Artefakte innerhalb von messages/ werden ignoriert.
# (Die frühere Regel `messages/*.json` mit Ausnahmen nur für de/en/ar hätte
#  jede neu angelegte Sprachdatei stillschweigend vom Commit ausgeschlossen —
#  die Seite wäre im Deployment unbemerkt auf Englisch zurückgefallen.)
# ---------------------------------------------------------------------------
messages/*.js
messages/*.py
messages/*.txt
messages/*.sh
messages/*.bak
messages/*.jsonl
messages/batch*.json
messages/chunk*.json
messages/tmp_*.json
messages/temp_*.json
messages/scratch_*.json
messages/*_temp*.json
messages/*_part*.json
