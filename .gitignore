# ---------------------------------------------------------------------------
# Generierungs-/Scratch-Artefakte
#
# Hintergrund: Das Repo enthielt ~3.000 Dump- und Skriptdateien aus früheren
# KI-Generierungsläufen. Die Regeln unten fangen typische Muster ab, BEVOR sie
# eingecheckt werden. Wichtig: .gitignore wirkt nur auf noch nicht getrackte
# Dateien — bereits getrackte müssen mit `git rm --cached` entfernt werden.
# ---------------------------------------------------------------------------

# Einmal-Skripte im Repo-Root (echte Skripte gehören nach scripts/)
/*.js
/*.py
/*.mjs
/*.cjs
!/eslint.config.mjs
!/postcss.config.mjs

# Daten-Dumps und Zwischenstände im Repo-Root
/*.txt
/*.json
/*.jsonl
/*.html
/*.part
!/package.json
!/package-lock.json
!/tsconfig.json
!/components.json

# Videos gehören nach public/videos/ (die sind getrackt und werden ausgeliefert).
# Streuner in public/images/ nicht committen — dort liegt u. a. eine 146-MB-Datei,
# die von keiner Seite referenziert wird.
public/images/**/*.mp4

# Scratch-Ordner
/scratch/
/scratch_chunks/
/temp_de_chunks/
/tmp/
/export-*/
/.agents/

# Interne Dokumente — niemals ausliefern oder committen
docs/confidential/

# ---------------------------------------------------------------------------
# messages/: ALLE Sprachdateien werden getrackt (Deployment braucht sie).
# Nur Generierungs-Artefakte innerhalb von messages/ werden ignoriert.
# (Die frühere Regel `messages/*.json` mit Ausnahmen nur für de/en/ar hätte
#  jede neu angelegte Sprachdatei stillschweigend vom Commit ausgeschlossen —
#  die Seite wäre im Deployment unbemerkt auf Englisch zurückgefallen.)
# ---------------------------------------------------------------------------
messages/*.js
messages/*.py
messages/*.txt
messages/*.sh
messages/*.bak
messages/*.jsonl
messages/batch*.json
messages/chunk*.json
messages/tmp_*.json
messages/temp_*.json
messages/scratch_*.json
messages/*_temp*.json
messages/*_part*.json

# Arbeitsunterlagen, keine Website-Bestandteile.
# Die 3D-Produktionsstrecke selbst liegt versioniert in docs/3d-produktion/.
/K-Aqua Unterseitem Kopie/
/Backlinks K-Aqua/

# ---------------------------------------------------------------------------
# Marketing-Quellarchiv
#
# 381 MB, 546 Dateien: Studiofotografie in voller Auflösung (bis 5616×3744),
# TIFF-Masterdateien, der 121-seitige Katalog, Logos, Videos. Das ist das
# ARCHIV, aus dem die Website-Fassungen abgeleitet werden — nicht die Website
# selbst. Ins Repository gehören ausschließlich die abgeleiteten, web-tauglichen
# Dateien unter public/.
#
# Ohne diesen Eintrag würde ein `git add -A` — die in diesem Projekt übliche
# Form — 381 MB in ein .git schreiben, das bereits 690 MB groß ist. Jeder Clone
# und jeder CI-Lauf trüge das dauerhaft mit.
#
# ACHTUNG: Der Ordner ist damit NICHT gesichert. Er muss außerhalb des
# Repositories aufbewahrt werden — sonst ist er beim nächsten Rechnerwechsel
# verloren.
/Marketing/

# Und dieselben Kopien, die macOS beim Duplizieren mit einer Ziffer versieht.
# Der Eintrag darüber trägt einen führenden Schrägstrich und trifft deshalb
# GENAU einen Ordner — „Marketing 2" fiel nicht darunter und lag mit 381 MB
# und vier TIFFs über 20 MB unversioniert im Projektstamm, einen `git add -A`
# vom Commit entfernt. Dasselbe Muster steht unten für kaqua-3d.
/Marketing [0-9]/
/Marketing [0-9][0-9]/

# Abgelegte Kopien der 3D-Strecke, die macOS beim Duplizieren mit einer Ziffer
# versieht („kaqua-3d 3"). Die gültige Fassung liegt unter kaqua-3d/ bzw. wird
# nach public/kaqua-3d/ ausgeliefert; Duplikate im Projektstamm sind
# Arbeitsstände und gehören nicht in die Versionierung.
/kaqua-3d [0-9]/
/kaqua-3d [0-9][0-9]/

# Zwischenstände des inkrementellen 3D-Baus. Werden aus core/ und products/
# erzeugt (node kaqua-3d/build/incremental.mjs cache) und tragen einen
# Längenstempel; im Repo wären sie nur ein zweiter, stiller Stand.
/kaqua-3d/build/cache/
