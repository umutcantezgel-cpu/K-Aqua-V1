{
  "name": "k-aqua",
  "version": "1.0.0",
  "private": true,
  "description": "K-Aqua (KWT GmbH) — corporate website. Next.js 15 App Router · TypeScript · Tailwind CSS 4 · Framer Motion · next-intl.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-locale-parity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:usage": "node scripts/check-message-usage.mjs",
    "i18n:placeholders": "node scripts/check-locale-placeholders.mjs",
    "3d:sync": "node scripts/sync-3d-registry.mjs",
    "3d:check": "node scripts/sync-3d-registry.mjs --check",
    "3d:coverage": "node scripts/check-3d-coverage.mjs",
    "search:sync": "tsx scripts/sync-search-index.mjs",
    "search:check": "tsx scripts/sync-search-index.mjs --check",
    "names:sync": "tsx scripts/sync-article-names.ts",
    "names:check": "tsx scripts/sync-article-names.ts --check",
    "3d:seiten": "node scripts/check-3d-seiten.mjs",
    "3d:gestalt": "node scripts/messe-gestalt.mjs",
    "verify:h1": "tsx scripts/verify-h1.ts",
    "verify:meta": "tsx scripts/verify-meta.ts",
    "mail:selftest": "tsx scripts/mail-selftest.ts",
    "mail:preview": "tsx scripts/mail-preview.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
