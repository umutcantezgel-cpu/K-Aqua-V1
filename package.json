    "d3-geo": "^3.1.1",
    "gray-matter": "^4.0.3",
    "lodash": "^4.18.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.43.0",
    "next": "^15.5.19",
    "next-intl": "^3.26.0",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.14"
